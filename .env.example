# ---------- 数据与队列（docker compose up -d 提供） ----------
DATABASE_URL=postgres://laikela:laikela@127.0.0.1:5432/laikela
REDIS_URL=redis://127.0.0.1:6379

# ---------- 对象存储 ----------
# local = 存到 ./data/storage（默认，零额外依赖）
# s3    = MinIO / OSS / COS 等 S3 兼容存储，需先 docker compose --profile s3 up -d
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage

# STORAGE_DRIVER=s3 时生效
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=laikela
S3_ACCESS_KEY=laikela
S3_SECRET_KEY=laikela123

# ---------- 安全 ----------
# 生产必须换成随机值：openssl rand -hex 32
SIGNING_SECRET=laikela-dev-signing-secret
SIGNED_URL_TTL=21600

# 用户自带 API Key（BYOK）落库前的加密主密钥。
# 不填则退化用 SIGNING_SECRET 派生（开箱可跑）；生产建议单独配置，
# 且一旦有历史凭证就不要随意更换，否则旧密文解不开。
# CREDENTIAL_SECRET=

# 会话 cookie 是否只在 HTTPS 下发送。
# 本机 `next start` 走 http，设为 1 会导致登录「成功但立刻掉线」。
# 正式上线前置了 TLS 再打开。
# COOKIE_SECURE=1

# ---------- AI 供应商：平台托管的 Key ----------
# 这里是「全租户共用、平台付费」的 Key，配完要重启进程。
# 如果只想给某个租户用自己的 Key（BYOK），不用改这里，
# 登录后在 /settings/models 页面填，加密存库，即时生效且优先于这里的配置。
# 想接任意 OpenAI 兼容服务（自建网关/中转站），也在同一个页面「接入任意兼容模型」里填 URL + 模型名 + Key。
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名必须与 GET /models 的 id 完全一致（当前：deepseek-flash / deepseek-v4-pro），
# 写错会返回 400 model_not_found。改完跑 npm run check:ai 验一次。
# DEEPSEEK_MODEL=deepseek-flash

# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-pro-32k

# 阿里百炼：BaseUrl 必须到 /compatible-mode/v1 为止（专属网关地址与此类似）
# BAILIAN_API_KEY=sk-ws-xxxxxxxx
# BAILIAN_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# BAILIAN_TEXT_MODEL=qwen3.8-flash
# BAILIAN_IMAGE_MODEL=qwen-image-2.1-turbo

# ---------- 任务队列 ----------
WORKER_CONCURRENCY=2

# ---------- 注册邮箱验证 ----------
# 不配 SMTP_HOST 时走 outbox 驱动：邮件正文落到 mail_outbox 表并打到控制台，
# 注册接口还会把验证码放在响应里（仅非 production），本机不接真实邮箱也能跑通闭环。
# MAIL_DRIVER=smtp
MAIL_FROM=来客啦 <no-reply@laikela.local>
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=you@qq.com
# SMTP_PASS=授权码不是登录密码
REQUIRE_EMAIL_VERIFY=1
VERIFY_TTL_MINUTES=15
VERIFY_MAX_ATTEMPTS=5
VERIFY_RESEND_COOLDOWN=60
VERIFY_HOURLY_CAP=6

# ---------- 平台管理员 ----------
# 逗号分隔的邮箱，启动时自动把这些账号的 users.is_admin 置为 true。
# 也可以直接在库里改 users.is_admin。演示账号 owner@laikela.local 默认就是管理员。
# ADMIN_EMAILS=you@example.com

# ---------- 人工转账收款信息 ----------
# 在拿到个体户资质与微信/支付宝商户号之前，用「转账 + 人工核对」过渡
# （可行性分析见 docs/PAYMENT-ACCESS.md）。留空时页面提示「联系管理员获取」。
# PAY_PAYEE=杨某某
# PAY_WECHAT=微信号或手机号
# PAY_ALIPAY=支付宝账号
# PAY_BANK=开户行 + 卡号
# PAY_CONTACT=联系微信
# PAY_NOTE=转账时请备注注册邮箱，到账后管理员在后台确认并发放额度。
# 本地用 next start 做端到端测试时，允许把 outbox 里的验证码回传（生产勿开）
# MAIL_DEBUG_CODE=1
